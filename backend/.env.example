# Database connection (Neon serverless Postgres — https://neon.tech)
# Get this from your Neon project dashboard; sslmode=require is mandatory.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# App environment
APP_ENV=development
LOG_LEVEL=INFO

# Angel One SmartAPI (free — LTP display only, see docs/engine.md#live-data-angel-one)
# Generate api_key from https://smartapi.angelone.in (create an app under your account).
# angel_one_client_code is your Angel One trading/login ID (not mobile number).
# angel_one_mpin is your Angel One account MPIN — SmartAPI's generateSession
# uses it as the second login factor for MPIN-only accounts.
# angel_one_totp_secret is the base32 seed shown when you enable TOTP 2FA on the
# SmartAPI portal — save the raw secret, not just the QR code, since it's needed
# here to compute login OTPs programmatically (see app/data/angel_one_client.py).
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_MPIN=
ANGEL_ONE_TOTP_SECRET=

# Self-ping keepalive for Render free tier (spins down web services after
# 15 min idle). Render sets RENDER_EXTERNAL_URL automatically on deployed
# services — leave blank locally, no action needed on Render itself.
RENDER_EXTERNAL_URL=
HEALTH_PINGER_INTERVAL_MINUTES=5

# News collection module (app/news/ — free-tier only, not wired into scoring in v1)
# NewsAPI.org free dev tier: https://newsapi.org/register (100 req/day, dev use only)
NEWS_API_NEWSAPI_KEY=
# GNews.io free tier: https://gnews.io/register (100 req/day, non-commercial only)
NEWS_API_GNEWS_KEY=
